    "dropdown.background": "#252C3D",
    "dropdown.border": "#3A4258",
    "editor.background": "#252C3D",
    "editor.foreground": "#C6C8CF",
    "editorCursor.foreground": "#E6E9EF",
    "editor.lineHighlightBackground": "#2C3243",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#5B678666",
    "editor.inactiveSelectionBackground": "#4B557044",
    "editor.wordHighlightBackground": "#3A425866",
    "editor.wordHighlightStrongBackground": "#5A638255",
    "editor.findMatchBackground": "#8A7B4B88",
    "editor.findMatchForeground": "#E6E9EF",
    "editor.findMatchHighlightBackground": "#8A7B4B55",
    "editorBracketHighlight.foreground1": "#9FB2CF",
    "editorBracketHighlight.foreground2": "#9FC2A3",
    "editorBracketHighlight.foreground3": "#D3BF8A",
    "editorBracketHighlight.foreground4": "#B39AC8",
    "editorBracketHighlight.foreground5": "#8BB7C8",
    "editorBracketHighlight.foreground6": "#BFC4CF",
    "editorBracketMatch.background": "#2C3243",
    "editorBracketMatch.border": "#C6C8CF",
    "editorError.foreground": "#C27A7A",
    "editorWarning.foreground": "#D3BF8A",
    "editorInfo.foreground": "#8BB7C8",
    "editorHint.foreground": "#8B93A4",
    "editorInlayHint.background": "#00000000",
    "editorInlayHint.foreground": "#727B8EB3",
    "editorGutter.background": "#252C3D",
    "editorGutter.addedBackground": "#8FBF9A",
    "editorGutter.modifiedBackground": "#D3BF8A",
    "editorGutter.deletedBackground": "#C27A7A",
    "editorLineNumber.foreground": "#727B8E",
    "editorLineNumber.activeForeground": "#C6C8CF",
    "editorIndentGuide.background1": "#323A4F",
    "editorIndentGuide.activeBackground1": "#4A5470",
    "editorRuler.foreground": "#3A4258",
    "editorSuggestWidget.background": "#1D2230",
    "editorSuggestWidget.border": "#3A4258",
    "editorSuggestWidget.foreground": "#C6C8CF",
    "editorSuggestWidget.highlightForeground": "#9FB2CF",
    "editorSuggestWidget.selectedBackground": "#2C3243",
    "editorSuggestWidget.selectedForeground": "#E6E9EF",
    "editorWidget.background": "#252C3D",
    "editorGroupHeader.tabsBackground": "#1D2230",
    "editorGroupHeader.noTabsBackground": "#1D2230",
    "editorGroupHeader.border": "#2C3243",
    "focusBorder": "#9FB2CF",
    "input.background": "#2C3243",
    "input.border": "#3A4258",
    "input.foreground": "#C6C8CF",
    "input.placeholderForeground": "#727B8E",
    "list.activeSelectionBackground": "#2C3243",
    "list.activeSelectionForeground": "#E6E9EF",
    "list.focusBackground": "#2C3243",
    "list.focusForeground": "#E6E9EF",
    "list.highlightForeground": "#9FB2CF",
    "list.hoverBackground": "#262D3E",
    "list.hoverForeground": "#C6C8CF",
    "list.inactiveSelectionBackground": "#262D3E",
    "list.inactiveSelectionForeground": "#C6C8CF",
    "menu.background": "#252C3D",
    "menu.foreground": "#C6C8CF",
    "menu.selectionBackground": "#2C3243",
    "menu.selectionForeground": "#E6E9EF",
    "panel.background": "#1D2230",
    "panel.border": "#3A4258",
    "peekView.border": "#3A4258",
    "peekViewEditor.background": "#252C3D",
    "peekViewResult.background": "#1D2230",
    "pickerGroup.border": "#3A4258",
    "pickerGroup.foreground": "#AEB5C3",
    "progressBar.background": "#9FB2CF",
    "scrollbarSlider.background": "#2C3243B3",
    "scrollbarSlider.hoverBackground": "#4A5470B3",
    "scrollbarSlider.activeBackground": "#4A5470CC",
    "sideBar.background": "#1D2230",
    "sideBar.foreground": "#C6C8CF",
    "sideBar.border": "#3A4258",
    "sideBarSectionHeader.background": "#252C3D",
    "sideBarSectionHeader.foreground": "#C6C8CF",
    "statusBar.background": "#1D2230",
    "statusBar.foreground": "#AEB5C3",
    "statusBar.debuggingBackground": "#C27A7A",
    "statusBar.debuggingForeground": "#1D2230",
    "statusBarItem.hoverBackground": "#2C3243",
    "statusBarItem.remoteBackground": "#2C3243",
    "statusBarItem.remoteForeground": "#C6C8CF",
    "tab.activeBackground": "#3A4258",
    "tab.unfocusedActiveBackground": "#3A4258",
    "tab.activeForeground": "#E6E9EF",
    "tab.activeBorderTop": "#9FB2CF",
    "tab.border": "#2C3243",
    "tab.inactiveBackground": "#252C3D",
    "tab.hoverBackground": "#2C3243",
    "terminal.background": "#1D2230",
    "terminal.foreground": "#C6C8CF",
    "terminal.border": "#3A4258",
    "terminal.selectionBackground": "#5B678666",
    "terminalCursor.background": "#1D2230",
    "terminalCursor.foreground": "#E6E9EF",
    "terminal.ansiBlack": "#1A1F2C",
    "terminal.ansiRed": "#C56673",
    "terminal.ansiGreen": "#A5B48B",
    "terminal.ansiYellow": "#C7C29A",
    "terminal.ansiBlue": "#8BB7C8",
    "terminal.ansiMagenta": "#B39AC8",
    "terminal.ansiCyan": "#8FB7D6",
    "terminal.ansiWhite": "#C6C8CF",
    "terminal.ansiBrightBlack": "#727B8E",
    "terminal.ansiBrightRed": "#DE8795",
    "terminal.ansiBrightGreen": "#B8C79F",
    "terminal.ansiBrightYellow": "#D6D2AE",
    "terminal.ansiBrightBlue": "#9ABFD0",
    "terminal.ansiBrightMagenta": "#C2AED2",
    "terminal.ansiBrightCyan": "#B0CDD8",
    "terminal.ansiBrightWhite": "#E6E9EF",
    "terminalCommandDecoration.defaultBackground": "#8FA9C4",
    "terminalCommandDecoration.successBackground": "#A5B48B",
    "terminalCommandDecoration.errorBackground": "#C56673",
    "titleBar.activeBackground": "#1D2230",
    "titleBar.activeForeground": "#C6C8CF",
    "titleBar.inactiveBackground": "#1D2230",
    "titleBar.inactiveForeground": "#AEB5C3",
    "textLink.foreground": "#9FB2CF"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#727B8E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage", "keyword.control"],
      "settings": {
        "foreground": "#D3BF8A"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.regexp"],
      "settings": {
        "foreground": "#8FBF9A"
      }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#B7A1D9"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#8FB7D6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type",
        "entity.name.type.rust",
        "support.type.rust",
        "entity.name.type.parameter.rust"
      ],
      "settings": {
        "foreground": "#B48F5D"
      }
    },
    {
      "scope": [
        "entity.name.variant.rust",
        "entity.name.enum.variant.rust",
        "entity.name.type.variant",
        "entity.name.type.variant.rust",
        "entity.name.constant.rust",
        "meta.enum.rust entity.name.type.rust",
        "variable.other.enummember",
        "support.constant.enum",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#D9DEE8"
      }
    },
    {
      "scope": [
        "punctuation.brackets.angle",
        "punctuation.brackets.angle.rust",
        "punctuation.brackets.square",
        "punctuation.brackets.square.rust",
        "punctuation.section.braces.begin",
        "punctuation.section.braces.end",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.definition.parameters.begin",
        "punctuation.definition.parameters.end",
        "keyword.operator.arrow.rust",
        "keyword.operator.fat-arrow.rust",
        "storage.type.function.arrow.rust",
        "punctuation.definition.generic.begin.rust",
        "punctuation.definition.generic.end.rust"
      ],
      "settings": {
        "foreground": "#BEAF84"
      }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": {
        "foreground": "#C6C8CF"
      }
    },
    {
      "scope": [
        "punctuation.definition.variable.php",
        "meta.variable.php punctuation.definition.variable.php",
        "source.php punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#9099AB"
      }
    },
    {
      "scope": [
        "variable.language.this",
        "variable.language.this.php",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#B39AC8"
      }
    },
    {
      "scope": ["punctuation", "punctuation.definition"],
      "settings": {
        "foreground": "#AEB5C3"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.arrow",
        "keyword.operator.arrow.rust",
        "keyword.operator.fat-arrow",
        "keyword.operator.fat-arrow.rust",
        "storage.type.function.arrow",
        "storage.type.function.arrow.rust",
        "punctuation.brackets.angle",
        "punctuation.brackets.angle.rust",
        "punctuation.brackets.square",
        "punctuation.brackets.square.rust",
        "punctuation.section.braces.begin",
        "punctuation.section.braces.end",
        "punctuation.section.block.begin",
        "punctuation.section.block.end",
        "punctuation.definition.parameters.begin",
        "punctuation.definition.parameters.end",
        "punctuation.separator.key-value",
        "punctuation.separator.key-value.rust",
        "punctuation.definition.generic.begin.rust",
        "punctuation.definition.generic.end.rust"
      ],
      "settings": {
        "foreground": "#BEAF84"
      }
    },
    {
      "scope": ["markup.heading", "markup.heading.markdown"],
      "settings": {
        "foreground": "#D3BF8A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#8FB7D6"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "storage.type.annotation.java",
        "entity.name.type.annotation",
        "entity.name.type.annotation.java",
        "meta.annotation",
        "meta.annotation.java"
      ],
      "settings": {
        "foreground": "#B39AC8"
      }
    },
    {
      "scope": [
        "meta.enum.rust entity.name.type.rust",
        "meta.enum.rust entity.name.type",
        "meta.enum.rust meta.block.rust entity.name.type.rust",
        "meta.enum.rust meta.block.rust entity.name.type",
        "meta.enum.rust meta.group.rust entity.name.type.rust",
        "meta.enum.rust meta.group.rust entity.name.type",
        "meta.block.rust meta.enum.rust entity.name.type.rust",
        "meta.block.rust meta.enum.rust entity.name.type",
        "entity.name.type.variant",
        "entity.name.type.variant.rust",
        "entity.name.type.enum.variant",
        "entity.name.type.enum.variant.rust",
        "meta.enum.rust variable.other.readwrite",
        "meta.enum.rust variable.other"
      ],
      "settings": {
        "foreground": "#D9DEE8"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#C27A7A"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#B48F5D",
    "interface": "#B48F5D",
    "struct": "#B48F5D",
    "enum": "#B48F5D",
    "enumMember": "#D9DEE8",
    "enumMember.declaration": "#D9DEE8",
    "enumMember.readonly": "#D9DEE8",
    "enumMember:rust": "#D9DEE8",
    "enumMember.declaration:rust": "#D9DEE8",
    "enumMember.readonly:rust": "#D9DEE8",
    "type.declaration:rust": "#D9DEE8",
    "type": "#B48F5D",
    "type:rust": "#B48F5D",
    "typeParameter": "#9FB2CF",
    "decorator": "#B39AC8",
    "function": "#8FB7D6",
    "operator": "#BEAF84",
    "number": "#B7A1D9",
    "boolean": "#B7A1D9",
    "variable": "#C6C8CF",
    "parameter": "#C6C8CF",
    "property": "#8FB7D6"
  }
}
