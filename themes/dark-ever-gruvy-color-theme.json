    "titleBar.activeForeground": "#B8B09E",
    "titleBar.inactiveBackground": "#1C1E1F",
    "titleBar.inactiveForeground": "#8A8175",
    "textLink.foreground": "#769A90"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#617866", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "keyword.control"],
      "settings": { "foreground": "#B78491" }
    },
    {
      "scope": ["string", "string.quoted", "string.regexp"],
      "settings": { "foreground": "#A5A75B" }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language"],
      "settings": { "foreground": "#B66D4A" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#769A90" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "storage.type"],
      "settings": { "foreground": "#B89156" }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#B8B09E" }
    },
    {
      "scope": ["variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#B78491" }
    },
    {
      "scope": ["punctuation", "punctuation.definition", "keyword.operator"],
      "settings": { "foreground": "#B8B09E" }
    },
    {
      "scope": ["markup.heading", "markup.heading.markdown"],
      "settings": { "foreground": "#B89156", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#769A90" }
    },
    {
      "scope": ["entity.name.function.decorator", "meta.decorator", "storage.type.annotation"],
      "settings": { "foreground": "#B78491" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#B66D4A" }
    }
  ],
  "semanticTokenColors": {
    "class": "#B89156",
    "interface": "#B89156",
    "struct": "#B89156",
    "enum": "#B89156",
    "enumMember": "#B8B09E",
    "type": "#B89156",
    "typeParameter": "#769A90",
    "decorator": "#B78491",
    "function": "#769A90",
    "operator": "#B8B09E",
    "number": "#B66D4A",
    "boolean": "#B66D4A",
    "variable": "#B8B09E",
    "parameter": "#B8B09E",
    "property": "#769A90"
  }
}
